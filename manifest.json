{
  "manifest_version": 3,
  "name": "D&D Beyond Sheet Notes",
  "version": "1.3.0",
  "description": "Adds a per-character Markdown notes drawer, with sections and a split view, to D&D Beyond character sheets.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*",
        "https://www.dndbeyond.com/profile/*/characters/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
